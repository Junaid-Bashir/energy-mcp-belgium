{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "energy-mcp-belgium",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "MCP_ALLOWED_HOSTS": "127.0.0.1:*,localhost:*,[::1]:*",
    "MCP_ALLOWED_ORIGINS": ""
  },
  "dev": {"ip": "127.0.0.1", "port": 8797},
  "observability": {"enabled": false},
  "env": {
    "test": {
      "name": "energy-mcp-belgium",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "MCP_ALLOWED_HOSTS": "localhost",
        "MCP_ALLOWED_ORIGINS": "",
        "MCP_PROTECTION_REQUIRED": "true"
      },
      "ratelimits": [
        {"name": "MCP_INGRESS", "namespace_id": "1001", "simple": {"limit": 60, "period": 60}},
        {"name": "MCP_AGGREGATE", "namespace_id": "1002", "simple": {"limit": 120, "period": 60}},
        {"name": "ELIA_BURST", "namespace_id": "1003", "simple": {"limit": 20, "period": 10}},
        {"name": "ELIA_BUDGET", "namespace_id": "1004", "simple": {"limit": 120, "period": 60}}
      ],
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": {"enabled": true, "head_sampling_rate": 1, "invocation_logs": false, "persist": false}
      }
    }
  }
}
